<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+). allowBackup="false" disables cloud backup, but
  device-to-device transfer still runs unless excluded here. The
  flutter_secure_storage KeyStore key never leaves the device, so a restored
  copy of its encrypted prefs files could not be decrypted — exclude them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
